{
  "repository": "pypa/warehouse",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "lint": "eslint 'warehouse/static/js/warehouse/**' 'warehouse/admin/static/js/**' 'tests/frontend/**' 'webpack.*.js'",
    "lint:fix": "eslint 'warehouse/static/js/warehouse/**' 'warehouse/admin/static/js/**' 'tests/frontend/**' 'webpack.*.js' --fix",
    "stylelint": "stylelint '**/*.scss' --cache --cache-location .cache/stylelint",
    "stylelint:fix": "stylelint '**/*.scss' --cache --cache-location .cache/stylelint --fix",
    "test": "jest --coverage"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./tests/frontend/setup.js"
    ],
    "testEnvironment": "jsdom",
    "testRegex": ".*_test.js",
    "moduleNameMapper": {
      "^tabulator-tables$": "<rootDir>/node_modules/tabulator-tables/dist/js/tabulator_esm.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(tabulator-tables|debounce)/)"
    ],
    "transform": {
      "\\.m?[jt]sx?$": "babel-jest"
    }
  },
  "dependencies": {
    "@fontsource/ewert": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@hotwired/stimulus": "^3.2.1",
    "@hotwired/stimulus-webpack-helpers": "^1.0.1",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "admin-lte": "^3.2.0",
    "date-fns": "^4.1.0",
    "debounce": "^3.0.0",
    "jquery": "^3.7.0",
    "normalize.css": "^8.0.1",
    "stimulus-autocomplete": "^3.1.0",
    "tabulator-tables": "^6.4.0"
  },
  "overrides": {
    "datatables.net": "^1.13.11",
    "datatables.net-rowgroup-bs4": "<1.5.1",
    "datatables.net-searchbuilder": "<1.8.1",
    "datatables.net-searchpanes": "<2.3.2",
    "sweetalert2": "11.4.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "babel-jest": "^30.2.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "gettext-parser": "^9.0.0",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-fetch-mock": "^4.2.0",
    "mini-css-extract-plugin": "^2.7.2",
    "postcss-loader": "^8.1.1",
    "rtlcss": "^4.0.0",
    "sass-embedded": "^1.57.1",
    "sass-loader": "^17.0.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "svgo": "^4.1.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-manifest-plugin": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.0.3"
  }
}
