#!/bin/bash
set -ex


# When on GitHub Actions, configure ruff to use the github output style
if [ -n "$GITHUB_ACTIONS" ]; then
  export RUFF_OUTPUT_FORMAT=github
  export EXTRA_AST_GREP_ARGS="--format=github"
fi

# Actually run our tests.
ast-grep scan --error=unused-suppression --error=no-suppress-all $EXTRA_AST_GREP_ARGS

ruff check
ruff format --check --diff

sphinx-lint --enable=all --disable=line-too-long README.rst CONTRIBUTING.rst docs/dev/ --ignore=docs/dev/_build/
python -m djlint --check --lint ./warehouse/templates ./docs/blog

python -m mypy -p warehouse -p tests.common -p pyramid_components

# lint our pyproject.toml file (as well as any other toml files)
tombi lint --offline --error-on-warnings
tombi format --offline --check --diff
codespell

# Extract translatable strings to a scratch file, so a template or module
# that pybabel cannot parse fails here. messages.pot itself is regenerated
# on main by CI.
pot_check=$(mktemp)
trap 'rm -f "$pot_check"' EXIT
make -C warehouse/locale/ compile-pot POT_OUTPUT="$pot_check"
