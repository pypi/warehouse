#: warehouse/views.py:150
msgid ""
"You must verify your **primary** email address before you can perform this "
"action."
msgstr ""
"Du måste verifiera din **primära** e-postadress innan du kan utföra den här "
"åtgärden."

#: warehouse/views.py:166
msgid ""
"Two-factor authentication must be enabled on your account to perform this "
"action."
msgstr ""
"Tvåfaktorsautentisering måste vara aktiverad för ditt konto för att du ska "
"kunna utföra den här åtgärden."

#: warehouse/views.py:377
msgid "Locale updated"
msgstr "Språkinställningen har uppdaterats"

#: warehouse/accounts/forms.py:51 warehouse/accounts/forms.py:350
msgid "The email address isn't valid. Try again."
msgstr "E-postadressen är inte giltig. Försök igen."

#: warehouse/accounts/forms.py:52
msgid "The password is invalid. Try again."
msgstr "Lösenordet är ogiltigt. Försök igen."

#: warehouse/accounts/forms.py:54
msgid ""
"The username is invalid. Usernames must be composed of letters, numbers, "
"dots, hyphens and underscores. And must also start and finish with a letter "
"or number. Choose a different username."
msgstr ""
"Användarnamnet är ogiltigt. Användarnamn får innehålla bokstäver, siffror, "
"punkter, bindestreck och understreck. Det måste också börja och sluta med en "
"bokstav eller siffra. Välj ett annat användarnamn."

#: warehouse/accounts/forms.py:71
msgid "Null bytes are not allowed."
msgstr "Nollbyte är inte tillåtna."

#: warehouse/accounts/forms.py:87
msgid ""
"Usernames are not the same as email addresses. Enter your username instead "
"of your email address."
msgstr ""
"Användarnamn är inte samma sak som e-postadresser. Ange ditt användarnamn i "
"stället för din e-postadress."

#: warehouse/accounts/forms.py:99
msgid "No user found with that username"
msgstr "Ingen användare hittades med det användarnamnet"

#: warehouse/accounts/forms.py:127
#, python-brace-format
msgid "TOTP code must be ${totp_length} digits."
msgstr "TOTP-koden måste innehålla ${totp_length} siffror."

#: warehouse/accounts/forms.py:150
#, python-brace-format
msgid "Recovery Codes must be ${recovery_code_length} characters."
msgstr "Återställningskoder måste innehålla ${recovery_code_length} tecken."

#: warehouse/accounts/forms.py:164
msgid "Choose a username with 50 characters or less."
msgstr "Välj ett användarnamn med högst 50 tecken."

#: warehouse/accounts/forms.py:182
msgid ""
"This username is already being used by another account. Choose a different "
"username."
msgstr ""
"Det här användarnamnet används redan av ett annat konto. Välj ett annat "
"användarnamn."

#: warehouse/accounts/forms.py:221 warehouse/accounts/forms.py:278
#: warehouse/accounts/forms.py:291
msgid "Password too long."
msgstr "Lösenordet är för långt."

#: warehouse/accounts/forms.py:261
#, python-brace-format
msgid ""
"There have been too many unsuccessful login attempts. You have been locked "
"out for ${time}. Please try again later."
msgstr ""
"Det har gjorts för många misslyckade inloggningsförsök. Du är spärrad i $"
"{time}. Försök igen senare."

#: warehouse/accounts/forms.py:294
msgid "Your passwords don't match. Try again."
msgstr "Dina lösenord stämmer inte överens. Försök igen."

#: warehouse/accounts/forms.py:328
msgid "The email address is too long. Try again."
msgstr "E-postadressen är för lång. Försök igen."

#: warehouse/accounts/forms.py:410 warehouse/accounts/forms.py:532
msgid "You can't use an email address from this domain. Use a different email."
msgstr ""
"Du kan inte använda en e-postadress från den här domänen. Använd en annan e-"
"postadress."

#: warehouse/accounts/forms.py:425
msgid ""
"This email address is already being used by this account. Use a different "
"email."
msgstr ""
"Den här e-postadressen används redan av det här kontot. Använd en annan e-"
"postadress."

#: warehouse/accounts/forms.py:436
msgid ""
"This email address is already being used by another account. Use a different "
"email."
msgstr ""
"Den här e-postadressen används redan av ett annat konto. Använd en annan e-"
"postadress."

#: warehouse/accounts/forms.py:468
#, python-brace-format
msgid "Too many email addresses checked. Try again in ${time}."
msgstr "För många e-postadresser har kontrollerats. Försök igen om ${time}."

#: warehouse/accounts/forms.py:475
msgid "Too many email addresses checked. Try again later."
msgstr "För många e-postadresser har kontrollerats. Försök igen senare."

#: warehouse/accounts/forms.py:550
msgid "You can't use a disposable email address. Use a different email."
msgstr ""
"Du kan inte använda en tillfällig e-postadress. Använd en annan e-postadress."

#: warehouse/accounts/forms.py:585 warehouse/manage/forms.py:130
msgid "The name is too long. Choose a name with 100 characters or less."
msgstr "Namnet är för långt. Välj ett namn med högst 100 tecken."

#: warehouse/accounts/forms.py:590
msgid "URLs are not allowed in the name field."
msgstr "Webbadresser är inte tillåtna i namnfältet."

#: warehouse/accounts/forms.py:600
msgid "You must agree to the Terms of Service and Acceptable Use Policy."
msgstr ""
"Du måste godkänna användarvillkoren och policyn för godtagbar användning."

#: warehouse/accounts/forms.py:688
msgid "Invalid TOTP code."
msgstr "Ogiltig TOTP-kod."

#: warehouse/accounts/forms.py:705
msgid "Invalid WebAuthn assertion: Bad payload"
msgstr "Ogiltig WebAuthn-försäkran: felaktig nyttolast"

#: warehouse/accounts/forms.py:769
msgid "Invalid recovery code."
msgstr "Ogiltig återställningskod."

#: warehouse/accounts/forms.py:778
msgid "Recovery code has been previously used."
msgstr "Återställningskoden har redan använts."

#: warehouse/accounts/forms.py:807
msgid "The username isn't valid. Try again."
msgstr "Användarnamnet är inte giltigt. Försök igen."

#: warehouse/accounts/views.py:121
msgid ""
"There have been too many unsuccessful login attempts. You have been locked "
"out for Please try again later."
msgstr ""
"Det har gjorts för många misslyckade inloggningsförsök. Du är spärrad. "
"Försök igen senare."

#: warehouse/accounts/views.py:141
#, python-brace-format
msgid ""
"Too many emails have been added to this account without verifying them. "
"Check your inbox and follow the verification links. (IP: ${ip})"
msgstr ""
"För många e-postadresser har lagts till på det här kontot utan att "
"verifieras. Kontrollera din inkorg och följ verifieringslänkarna. (IP: ${ip})"

#: warehouse/accounts/views.py:153
#, python-brace-format
msgid ""
"Too many password resets have been requested for this account without "
"completing them. Check your inbox and follow the verification links. (IP: $"
"{ip})"
msgstr ""
"För många lösenordsåterställningar har begärts för det här kontot utan att "
"slutföras. Kontrollera din inkorg och följ verifieringslänkarna. (IP: ${ip})"

#: warehouse/accounts/views.py:376 warehouse/accounts/views.py:444
#: warehouse/accounts/views.py:446 warehouse/accounts/views.py:475
#: warehouse/accounts/views.py:477 warehouse/accounts/views.py:593
msgid "Invalid or expired two factor login."
msgstr "Ogiltig eller utgången tvåfaktorsinloggning."

#: warehouse/accounts/views.py:438
msgid "Already authenticated"
msgstr "Redan autentiserad"

#: warehouse/accounts/views.py:512
msgid "Successful WebAuthn assertion"
msgstr "WebAuthn-försäkran lyckades"

#: warehouse/accounts/views.py:623 warehouse/manage/views/__init__.py:988
msgid "Recovery code accepted. The supplied code cannot be used again."
msgstr ""
"Återställningskoden godkändes. Den angivna koden kan inte användas igen."

#: warehouse/accounts/views.py:730
msgid ""
"New user registration temporarily disabled. See https://pypi.org/help#admin-"
"intervention for details."
msgstr ""
"Registrering av nya användare är tillfälligt avstängd. Mer information finns "
"på https://pypi.org/help#admin-intervention."

#: warehouse/accounts/views.py:783
#, python-brace-format
msgid ""
"Too many registration attempts from your network. Please try again in $"
"{time}."
msgstr ""
"För många registreringsförsök har gjorts från ditt nätverk. Försök igen om $"
"{time}."

#: warehouse/accounts/views.py:791
msgid ""
"Too many registration attempts from your network. Please try again later."
msgstr ""
"För många registreringsförsök har gjorts från ditt nätverk. Försök igen "
"senare."

#: warehouse/accounts/views.py:849
msgid ""
"Too many password reset requests from your network. Please try again later."
msgstr ""
"För många begäranden om lösenordsåterställning har gjorts från ditt nätverk. "
"Försök igen senare."

#: warehouse/accounts/views.py:946
msgid "Expired token: request a new password reset link"
msgstr "Utgången token: begär en ny länk för lösenordsåterställning"

#: warehouse/accounts/views.py:948
msgid "Invalid token: request a new password reset link"
msgstr "Ogiltig token: begär en ny länk för lösenordsåterställning"

#: warehouse/accounts/views.py:950 warehouse/accounts/views.py:1063
#: warehouse/accounts/views.py:1128 warehouse/accounts/views.py:1234
#: warehouse/accounts/views.py:1412
msgid "Invalid token: no token supplied"
msgstr "Ogiltig token: ingen token angavs"

#: warehouse/accounts/views.py:954
msgid "Invalid token: not a password reset token"
msgstr "Ogiltig token: inte en token för lösenordsåterställning"

#: warehouse/accounts/views.py:959 warehouse/accounts/views.py:1072
msgid "Invalid token: user not found"
msgstr "Ogiltig token: användaren hittades inte"

#: warehouse/accounts/views.py:970
msgid "Invalid token: user has logged in since this token was requested"
msgstr "Ogiltig token: användaren har loggat in sedan denna token begärdes"

#: warehouse/accounts/views.py:988
msgid ""
"Invalid token: password has already been changed since this token was "
"requested"
msgstr "Ogiltig token: lösenordet har redan ändrats sedan denna token begärdes"

#: warehouse/accounts/views.py:1019
msgid "You have reset your password"
msgstr "Du har återställt ditt lösenord"

#: warehouse/accounts/views.py:1059
msgid "Expired token: please try to login again"
msgstr "Utgången token: försök att logga in igen"

#: warehouse/accounts/views.py:1061
msgid "Invalid token: please try to login again"
msgstr "Ogiltig token: försök att logga in igen"

#: warehouse/accounts/views.py:1067
msgid "Invalid token: not a login confirmation token"
msgstr "Ogiltig token: inte en token för inloggningsbekräftelse"

#: warehouse/accounts/views.py:1082
msgid "Invalid login attempt."
msgstr "Ogiltigt inloggningsförsök."

#: warehouse/accounts/views.py:1087
msgid ""
"Device details didn't match, please try again from the device you originally "
"used to log in."
msgstr ""
"Enhetsinformationen stämde inte överens. Försök igen från enheten du "
"ursprungligen använde för att logga in."

#: warehouse/accounts/views.py:1098
msgid "Your login has been confirmed and this device is now recognized."
msgstr "Din inloggning har bekräftats och denna enhet känns nu igen."

#: warehouse/accounts/views.py:1124
msgid "Expired token: request a new email verification link"
msgstr "Utgången token: begär en ny länk för e-postverifiering"

#: warehouse/accounts/views.py:1126
msgid "Invalid token: request a new email verification link"
msgstr "Ogiltig token: begär en ny länk för e-postverifiering"

#: warehouse/accounts/views.py:1132
msgid "Invalid token: not an email verification token"
msgstr "Ogiltig token: inte en token för e-postverifiering"

#: warehouse/accounts/views.py:1141
msgid "Email not found"
msgstr "E-postadressen hittades inte"

#: warehouse/accounts/views.py:1144
msgid "Email already verified"
msgstr "E-postadressen är redan verifierad"

#: warehouse/accounts/views.py:1164
msgid "You can now set this email as your primary address"
msgstr "Du kan nu ange denna e-postadress som din primära adress"

#: warehouse/accounts/views.py:1167
msgid "This is your primary address"
msgstr "Detta är din primära adress"

#: warehouse/accounts/views.py:1173
#, python-brace-format
msgid "Email address ${email_address} verified. ${confirm_message}."
msgstr "E-postadressen ${email_address} har verifierats. ${confirm_message}."

#: warehouse/accounts/views.py:1230
msgid "Expired token: request a new organization invitation"
msgstr "Utgången token: begär en ny organisationsinbjudan"

#: warehouse/accounts/views.py:1232
msgid "Invalid token: request a new organization invitation"
msgstr "Ogiltig token: begär en ny organisationsinbjudan"

#: warehouse/accounts/views.py:1238
msgid "Invalid token: not an organization invitation token"
msgstr "Ogiltig token: inte en token för organisationsinbjudan"

#: warehouse/accounts/views.py:1242 warehouse/accounts/views.py:1253
msgid "Organization invitation is not valid."
msgstr "Organisationsinbjudan är inte giltig."

#: warehouse/accounts/views.py:1251
msgid "Organization invitation no longer exists."
msgstr "Organisationsinbjudan finns inte längre."

#: warehouse/accounts/views.py:1259 warehouse/accounts/views.py:1446
msgid ""
"Invalid invitation: the inviting user no longer exists. Please ask a "
"remaining owner to reissue your invitation."
msgstr ""
"Ogiltig inbjudan: användaren som bjöd in dig finns inte längre. Be en "
"kvarvarande ägare att utfärda inbjudan på nytt."

#: warehouse/accounts/views.py:1313
#, python-brace-format
msgid "Invitation for '${organization_name}' is declined."
msgstr "Inbjudan till '${organization_name}' har avböjts."

#: warehouse/accounts/views.py:1375
#, python-brace-format
msgid "You are now ${role} of the '${organization_name}' organization."
msgstr "Du är nu ${role} i organisationen '${organization_name}'."

#: warehouse/accounts/views.py:1408
msgid "Expired token: request a new project role invitation"
msgstr "Utgången token: begär en ny projektrollsinbjudan"

#: warehouse/accounts/views.py:1410
msgid "Invalid token: request a new project role invitation"
msgstr "Ogiltig token: begär en ny projektrollsinbjudan"

#: warehouse/accounts/views.py:1416
msgid "Invalid token: not a collaboration invitation token"
msgstr "Ogiltig token: inte en token för samarbetsinbjudan"

#: warehouse/accounts/views.py:1420 warehouse/accounts/views.py:1440
msgid "Role invitation is not valid."
msgstr "Rollinbjudan är inte giltig."

#: warehouse/accounts/views.py:1427
msgid "Invalid token: project does not exist"
msgstr "Ogiltig token: projektet finns inte"

#: warehouse/accounts/views.py:1438
msgid "Role invitation no longer exists."
msgstr "Rollinbjudan finns inte längre."

#: warehouse/accounts/views.py:1480
#, python-brace-format
msgid "Invitation for '${project_name}' is declined."
msgstr "Inbjudan till '${project_name}' har avböjts."

#: warehouse/accounts/views.py:1545
#, python-brace-format
msgid "You are now ${role} of the '${project_name}' project."
msgstr "Du är nu ${role} i projektet '${project_name}'."

#: warehouse/accounts/views.py:1656
#, python-brace-format
msgid "Please review our updated <a href=\"${tos_url}\">Terms of Service</a>."
msgstr ""
"Läs igenom våra uppdaterade <a href=\"${tos_url}\">användarvillkor</a>."

#: warehouse/accounts/views.py:1883 warehouse/accounts/views.py:2151
#: warehouse/manage/views/oidc_publishers.py:126
#: warehouse/manage/views/organizations.py:1772
msgid ""
"Trusted publishing is temporarily disabled. See https://pypi.org/help#admin-"
"intervention for details."
msgstr ""
"Betrodd publicering är tillfälligt avstängd. Mer information finns på "
"https://pypi.org/help#admin-intervention."

#: warehouse/accounts/views.py:1904
#: warehouse/manage/views/organizations.py:1795
msgid "disabled. See https://pypi.org/help#admin-intervention for details."
msgstr ""
"avstängd. Mer information finns på https://pypi.org/help#admin-intervention."

#: warehouse/accounts/views.py:1920
msgid ""
"You must have a verified email in order to register a pending trusted "
"publisher. See https://pypi.org/help#openid-connect for details."
msgstr ""
"Du måste ha en verifierad e-postadress för att registrera en väntande "
"betrodd utgivare. Mer information finns på https://pypi.org/help#openid-"
"connect."

#: warehouse/accounts/views.py:1933
msgid "You can't register more than 3 pending trusted publishers at once."
msgstr "Du kan inte registrera fler än 3 väntande betrodda utgivare samtidigt."

#: warehouse/accounts/views.py:1948
#: warehouse/manage/views/oidc_publishers.py:308
#: warehouse/manage/views/oidc_publishers.py:423
#: warehouse/manage/views/oidc_publishers.py:539
#: warehouse/manage/views/oidc_publishers.py:651
msgid ""
"There have been too many attempted trusted publisher registrations. Try "
"again later."
msgstr ""
"Det har gjorts för många försök att registrera betrodda utgivare. Försök "
"igen senare."

#: warehouse/accounts/views.py:1958
#: warehouse/manage/views/oidc_publishers.py:321
#: warehouse/manage/views/oidc_publishers.py:436
#: warehouse/manage/views/oidc_publishers.py:552
#: warehouse/manage/views/oidc_publishers.py:664
#: warehouse/manage/views/organizations.py:1811
msgid "The trusted publisher could not be registered"
msgstr "Den betrodda utgivaren kunde inte registreras"

#: warehouse/accounts/views.py:1973
msgid ""
"This trusted publisher has already been registered. Please contact PyPI's "
"admins if this wasn't intentional."
msgstr ""
"Denna betrodda utgivare har redan registrerats. Kontakta PyPI:s "
"administratörer om detta inte var avsiktligt."

#: warehouse/accounts/views.py:1998
msgid ""
"A pending trusted publisher matching this configuration has already been "
"registered for a different project name. Please contact PyPI's admins if "
"this wasn't intentional."
msgstr ""
"En väntande betrodd utgivare som matchar denna konfiguration har redan "
"registrerats för ett annat projektnamn. Kontakta PyPI:s administratörer om "
"detta inte var avsiktligt."

#: warehouse/accounts/views.py:2021
#: warehouse/manage/views/organizations.py:1863
msgid "Registered a new pending publisher to create "
msgstr "Registrerade en ny väntande utgivare för att skapa "

#: warehouse/accounts/views.py:2164 warehouse/accounts/views.py:2177
#: warehouse/accounts/views.py:2184
msgid "Invalid publisher ID"
msgstr "Ogiltigt utgivar-id"

#: warehouse/accounts/views.py:2191
msgid "Removed trusted publisher for project "
msgstr "Tog bort betrodd utgivare för projektet "

#: warehouse/admin/templates/admin/banners/preview.html:4
msgid "Banner Preview"
msgstr "Förhandsvisning av banderoll"

#: warehouse/manage/forms.py:293
msgid "Specify an association ID"
msgstr "Ange ett kopplings-id"

#: warehouse/manage/forms.py:294
msgid "Association must be specified by ID"
msgstr "Kopplingen måste anges med id"

#: warehouse/manage/forms.py:312
msgid "No account association with given ID"
msgstr "Ingen kontokoppling med det angivna id:t"

#: warehouse/manage/forms.py:317
msgid "This association does not belong to you"
msgstr "Den här kopplingen tillhör inte dig"

#: warehouse/manage/forms.py:421
msgid "Provide your response to the request."
msgstr "Ange ditt svar på begäran."

#: warehouse/manage/forms.py:463
msgid "Choose an organization account name with 50 characters or less."
msgstr "Välj ett organisationskontonamn med högst 50 tecken."

#: warehouse/manage/forms.py:471
msgid ""
"The organization account name is invalid. Organization account names must be "
"composed of letters, numbers, dots, hyphens and underscores. And must also "
"start and finish with a letter or number. Choose a different organization "
"account name."
msgstr ""
"Organisationskontonamnet är ogiltigt. Organisationskontonamn får innehålla "
"bokstäver, siffror, punkter, bindestreck och understreck. Det måste också "
"börja och sluta med en bokstav eller siffra. Välj ett annat "
"organisationskontonamn."

#: warehouse/manage/forms.py:494
msgid ""
"This organization account name has already been used. Choose a different "
"organization account name."
msgstr ""
"Det här organisationskontonamnet används redan. Välj ett annat "
"organisationskontonamn."

#: warehouse/manage/forms.py:509
msgid ""
"You have already submitted an application for that name. Choose a different "
"organization account name."
msgstr ""
"Du har redan skickat in en ansökan för det namnet. Välj ett annat "
"organisationskontonamn."

#: warehouse/manage/forms.py:543
msgid "Select project"
msgstr "Välj projekt"

#: warehouse/manage/forms.py:548 warehouse/oidc/forms/_core.py:32
#: warehouse/oidc/forms/gitlab.py:54
msgid "Specify project name"
msgstr "Ange projektnamn"

#: warehouse/manage/forms.py:552
msgid ""
"Start and end with a letter or numeral containing only ASCII numeric and "
"'.', '_' and '-'."
msgstr ""
"Börja och sluta med en bokstav eller siffra. Endast ASCII-siffror samt '.', "
"'_' och '-' tillåts."

#: warehouse/manage/forms.py:559
msgid ""
"This project name has already been used. Choose a different project name."
msgstr "Det här projektnamnet används redan. Välj ett annat projektnamn."

#: warehouse/manage/forms.py:592
msgid "Cannot transfer to Company Organization with inactive billing"
msgstr ""
"Det går inte att överföra till en företagsorganisation med inaktiv "
"fakturering"

#: warehouse/manage/forms.py:660
msgid ""
"The organization name is too long. Choose a organization name with 100 "
"characters or less."
msgstr ""
"Organisationsnamnet är för långt. Välj ett organisationsnamn med högst 100 "
"tecken."

#: warehouse/manage/forms.py:673
msgid ""
"The organization URL is too long. Choose a organization URL with 400 "
"characters or less."
msgstr ""
"Organisationens URL är för lång. Välj en organisations-URL med högst 400 "
"tecken."

#: warehouse/manage/forms.py:679
msgid "The organization URL must start with http:// or https://"
msgstr "Organisationens URL måste börja med http:// eller https://"

#: warehouse/manage/forms.py:691
msgid ""
"The organization description is too long. Choose a organization description "
"with 400 characters or less."
msgstr ""
"Organisationsbeskrivningen är för lång. Välj en organisationsbeskrivning med "
"högst 400 tecken."

#: warehouse/manage/forms.py:732
msgid ""
"We don't need to know quite that much :), limit your usage description to "
"1024 characters or less."
msgstr ""
"Vi behöver inte veta riktigt så mycket. Begränsa användningsbeskrivningen "
"till högst 1024 tecken."

#: warehouse/manage/forms.py:763
#, python-brace-format
msgid ""
"You have already submitted the maximum number of Organization requests ($"
"{count})."
msgstr ""
"Du har redan skickat in det högsta antalet organisationsförfrågningar ($"
"{count})."

#: warehouse/manage/forms.py:794
msgid "Choose a team name with 50 characters or less."
msgstr "Välj ett lagnamn med högst 50 tecken."

#: warehouse/manage/forms.py:801
msgid ""
"The team name is invalid. Team names cannot start or end with a space, "
"period, underscore, hyphen, or slash. Choose a different team name."
msgstr ""
"Lagnamnet är ogiltigt. Lagnamn får inte börja eller sluta med ett "
"mellanslag, en punkt, ett understreck, ett bindestreck eller ett snedstreck. "
"Välj ett annat lagnamn."

#: warehouse/manage/forms.py:828
msgid "This team name has already been used. Choose a different team name."
msgstr "Det här lagnamnet används redan. Välj ett annat lagnamn."

