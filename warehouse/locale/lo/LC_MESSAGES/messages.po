#: warehouse/templates/manage/project/settings.html:124
msgid "Transferring this project will:"
msgstr "ການໂອນໂຄງການນີ້ຈະ:"

#: warehouse/templates/manage/project/settings.html:135
msgid "Revoke your direct Owner role on the project."
msgstr "ຖອນສິດບົດບາດການເປັນເຈົ້າຂອງໂດຍກົງຂອງທ່ານໃນໂຄງການນີ້."

#: warehouse/templates/manage/project/settings.html:136
msgid ""
"You will retain Owner permissions on the project through your organization "
"role."
msgstr "ທ່ານຈະຍັງຄົງມີສິດອະນຸຍາດເປັນເຈົ້າຂອງໃນໂຄງການນີ້ຜ່ານບົດບາດໃນອົງກອນຂອງທ່ານ."

#: warehouse/templates/manage/project/settings.html:140
msgid "Add the project to another organization that you own."
msgstr "ເພີ່ມໂຄງການເຂົ້າໃນອົງກອນອື່ນທີ່ທ່ານເປັນເຈົ້າຂອງ."

#: warehouse/templates/manage/project/settings.html:142
msgid "Add the project to an organization that you own."
msgstr "ເພີ່ມໂຄງການເຂົ້າໃນອົງກອນທີ່ທ່ານເປັນເຈົ້າຂອງ."

#: warehouse/templates/manage/project/settings.html:145
msgid "Grant full project permissions to owners of the organization."
msgstr "ມອບສິດອະນຸຍາດໂຄງການທັງໝົດໃຫ້ກັບເຈົ້າຂອງອົງກອນ."

#: warehouse/templates/manage/project/settings.html:148
msgid ""
"All other individual owners and maintainers of the project will retain their "
"project permissions."
msgstr ""
"ເຈົ້າຂອງບຸກຄົນອື່ນໆ ແລະ ຜູ້ບຳລຸງຮັກສາໂຄງການທັງໝົດຈະຍັງຄົງມີສິດອະນຸຍາດໃນໂຄງການຂອງພວກເຂົາຄືເກົ່າ."

#: warehouse/templates/manage/project/settings.html:170
msgid "Transfer project"
msgstr "ໂອນໂຄງການ"

#: warehouse/templates/manage/project/settings.html:176
msgid "Cannot transfer project to another organization"
msgstr "ບໍ່ສາມາດໂອນໂຄງການໄປຍັງອົງກອນອື່ນໄດ້"

#: warehouse/templates/manage/project/settings.html:178
msgid "Cannot transfer project to an organization"
msgstr "ບໍ່ສາມາດໂອນໂຄງການໄປຍັງອົງກອນໄດ້"

#: warehouse/templates/manage/project/settings.html:183
msgid ""
"Organization owners can transfer the project to organizations that they own "
"or manage."
msgstr "ເຈົ້າຂອງອົງກອນສາມາດໂອນໂຄງການໄປຍັງອົງກອນທີ່ພວກເຂົາເປັນເຈົ້າຂອງ ຫຼື ຈັດການໄດ້."

#: warehouse/templates/manage/project/settings.html:184
msgid "You are not an owner or manager of any other organizations."
msgstr "ທ່ານບໍ່ໄດ້ເປັນເຈົ້າຂອງ ຫຼື ຜູ້ຈັດການອົງກອນອື່ນໆເລີຍ."

#: warehouse/templates/manage/project/settings.html:186
msgid ""
"Project owners can transfer the project to organizations that they own or "
"manage."
msgstr "ເຈົ້າຂອງໂຄງການສາມາດໂອນໂຄງການໄປຍັງອົງກອນທີ່ພວກເຂົາເປັນເຈົ້າຂອງ ຫຼື ຈັດການໄດ້."

#: warehouse/templates/manage/project/settings.html:187
msgid "You are not an owner or manager of any organizations."
msgstr "ທ່ານບໍ່ໄດ້ເປັນເຈົ້າຂອງ ຫຼື ຜູ້ຈັດການອົງກອນໃດໆເລີຍ."

#: warehouse/templates/manage/project/settings.html:192
#: warehouse/templates/manage/project/settings.html:217
#: warehouse/templates/manage/project/settings.html:221
msgid "Archive project"
msgstr "ເກັບໂຄງການໄວ້ໃນບ່ອນເກັບຖາວອນ"

#: warehouse/templates/manage/project/settings.html:196
#, python-format
msgid ""
"Archiving a project will prevent any new uploads, and remove the project "
"from PyPI's search results. Before doing so, we recommend publishing a final "
"release with an update to the project's description to warn the users that "
"the project won't receive further updates, and to mention any alternative "
"projects they may consider as a replacement. If your project is <a "
"href=\"%(readme_description_href)s\" rel=\"noopener\" "
"target=\"_blank\">configured to do so</a>, you can update the project's "
"description by editing the README file."
msgstr ""
"ການເກັບໂຄງການໄວ້ໃນບ່ອນເກັບຖາວອນຈະປ້ອງກັນການອັບໂຫຼດໃໝ່ ແລະ ເອົາໂຄງການອອກຈາກຜົນການຄົ້ນຫາຂອງ "
"PyPI. ກ່ອນທີ່ຈະເຮັດແນວນັ້ນ, "
"ພວກເຮົາແນະນຳໃຫ້ເຜີຍແຜ່ລຸ້ນສຸດທ້າຍພ້ອມກັບການອັບເດດຄຳອະທິບາຍໂຄງການເພື່ອເຕືອນຜູ້ໃຊ້ວ່າໂຄງການຈະບໍ່ໄດ້ຮັບການອັບເດດອີກຕໍ່ໄປ, "
"ແລະ ເພື່ອແນະນຳໂຄງການທາງເລືອກອື່ນທີ່ພວກເຂົາອາດຈະພິຈາລະນາໃຊ້ແທນ. ຖ້າໂຄງການຂອງທ່ານຖືກ <a "
"href=\"%(readme_description_href)s\" rel=\"noopener\" "
"target=\"_blank\">ຕັ້ງຄ່າໃຫ້ເຮັດແນວນັ້ນ</a>, "
"ທ່ານສາມາດອັບເດດຄຳອະທິບາຍໂຄງການໄດ້ໂດຍການແກ້ໄຂໄຟລ໌ README."

#: warehouse/templates/manage/project/settings.html:208
#: warehouse/templates/manage/project/settings.html:211
msgid "Unarchive project"
msgstr "ຍົກເລີກການເກັບໂຄງການໄວ້ໃນບ່ອນເກັບຖາວອນ"

#: warehouse/templates/manage/project/settings.html:212
msgid ""
"Unarchiving a project will allow new file uploads and add the project to the "
"search index."
msgstr ""
"ການຍົກເລີກການເກັບໂຄງການໄວ້ໃນບ່ອນເກັບຖາວອນຈະອະນຸຍາດໃຫ້ມີການອັບໂຫຼດໄຟລ໌ໃໝ່ ແລະ "
"ເພີ່ມໂຄງການເຂົ້າໃນດັດຊະນີການຄົ້ນຫາ."

#: warehouse/templates/manage/project/settings.html:222
msgid ""
"Archiving a project will block any new file uploads and remove the project "
"from the search index."
msgstr ""
"ການເກັບໂຄງການໄວ້ໃນບ່ອນເກັບຖາວອນຈະບລັອກການອັບໂຫຼດໄຟລ໌ໃໝ່ ແລະ "
"ເອົາໂຄງການອອກຈາກດັດຊະນີການຄົ້ນຫາ."

#: warehouse/templates/manage/project/settings.html:228
#: warehouse/templates/manage/project/settings.html:304
msgid "Delete project"
msgstr "ລຶບໂຄງການ"

#: warehouse/templates/manage/project/settings.html:231
msgid "Deleting this project will:"
msgstr "ການລຶບໂຄງການນີ້ຈະ:"

#: warehouse/templates/manage/project/settings.html:236
#, python-format
msgid ""
"Irreversibly delete the project along with <a href=\"%(href)s\">%(count)s "
"release</a>"
msgid_plural ""
"Irreversibly delete the project along with <a href=\"%(href)s\">%(count)s "
"releases</a>"
msgstr[0] ""
"ລຶບໂຄງການນີ້ຢ່າງຖາວອນພ້ອມກັບ <a href=\"%(href)s\">%(count)s ລຸ້ນ</a> ໂດຍບໍ່ສາມາດກູ້ຄືນໄດ້"

#: warehouse/templates/manage/project/settings.html:242
msgid "Irreversibly delete the project"
msgstr "ລຶບໂຄງການຢ່າງຖາວອນໂດຍບໍ່ສາມາດກູ້ຄືນໄດ້"

#: warehouse/templates/manage/project/settings.html:246
msgid "Make the project name available to <strong>any other PyPI</strong> user"
msgstr "ເຮັດໃຫ້ຊື່ໂຄງການວ່າງສຳລັບຜູ້ໃຊ້ <strong>PyPI ຄົນອື່ນໆ</strong>"

#: warehouse/templates/manage/project/settings.html:249
msgid ""
"This user will be able to make new releases under this project name, so long "
"as the distribution filenames do not match filenames from a previously "
"released distribution (all PyPI distribution filenames are unique, as they "
"are generated by combining the project name + version number + distribution "
"type)"
msgstr ""
"ຜູ້ໃຊ້ນີ້ຈະສາມາດສ້າງລຸ້ນໃໝ່ພາຍໃຕ້ຊື່ໂຄງການນີ້ໄດ້, "
"ຕາບໃດທີ່ຊື່ໄຟລ໌ການແຈກຢາຍບໍ່ກົງກັບຊື່ໄຟລ໌ຈາກການແຈກຢາຍທີ່ເຄີຍປ່ອຍມາກ່ອນໜ້ານີ້ (ຊື່ໄຟລ໌ການແຈກຢາຍ PyPI "
"ທັງໝົດແມ່ນເປັນເອກະລັກ, ເພາະມັນຖືກສ້າງຂຶ້ນໂດຍການລວມ ຊື່ໂຄງການ + ເລກລຸ້ນ + ປະເພດການແຈກຢາຍ)"

