#: warehouse/templates/email/password-change/body.html:5
#, python-format
msgid ""
"Someone, perhaps you, has changed the password for your PyPI account "
"<strong>%(username)s</strong>."
msgstr ""
"ມີບາງຄົນ, ຫຼື ອາດແມ່ນທ່ານ, ໄດ້ປ່ຽນລະຫັດຜ່ານສຳລັບບັນຊີ PyPI ຂອງທ່ານ <strong>%(username)s</"
"strong>."

#: warehouse/templates/email/password-compromised-hibp/body.html:4
#: warehouse/templates/email/password-compromised/body.html:4
msgid "What?"
msgstr "ແມ່ນຫຍັງ?"

#: warehouse/templates/email/password-compromised/body.html:6
msgid ""
"PyPI administrators have determined that your password is compromised. To "
"protect you and other users, we have preemptively reset your password and "
"you will no longer be able to log in or upload to PyPI with your existing "
"password."
msgstr ""
"ຜູ້ດູແລລະບົບ PyPI ກວດພົບວ່າລະຫັດຜ່ານຂອງທ່ານຕົກຢູ່ໃນຄວາມສ່ຽງ. ເພື່ອປົກປ້ອງທ່ານ ແລະ ຜູ້ໃຊ້ອື່ນໆ, "
"ພວກເຮົາໄດ້ຕັ້ງລະຫັດຜ່ານຂອງທ່ານໃໝ່ໄວ້ກ່ອນ ແລະ ທ່ານຈະບໍ່ສາມາດເຂົ້າສູ່ລະບົບ ຫຼື ອັບໂຫຼດໄປຫາ PyPI "
"ດ້ວຍລະຫັດຜ່ານເກົ່າໄດ້ອີກ."

#: warehouse/templates/email/password-compromised/body.html:12
msgid ""
"PyPI itself has not suffered a breach. This is a protective measure to "
"reduce the risk for PyPI and its users."
msgstr ""
"ຕົວລະບົບ PyPI ເອງບໍ່ໄດ້ຖືກບຸກລຸກ. ນີ້ແມ່ນມາດຕະການປ້ອງກັນເພື່ອຫຼຸດຜ່ອນຄວາມສ່ຽງສຳລັບ PyPI ແລະ ຜູ້ໃຊ້."

#: warehouse/templates/email/password-compromised-hibp/body.html:16
#: warehouse/templates/email/password-compromised/body.html:15
msgid "What should I do?"
msgstr "ຂ້ອຍຄວນເຮັດແນວໃດ?"

#: warehouse/templates/email/password-compromised/body.html:17
#, python-format
msgid ""
"To regain access to your account, <a href=\"%(href)s\">reset your password</"
"a> on PyPI."
msgstr ""
"ເພື່ອເຂົ້າເຖິງບັນຊີຂອງທ່ານຄືນໃໝ່, ກະລຸນາ <a href=\"%(href)s\">ຕັ້ງລະຫັດຜ່ານຂອງທ່ານໃໝ່</a> ໃນ "
"PyPI."

#: warehouse/templates/email/password-compromised/body.html:21
msgid "How can I contact you?"
msgstr "ຂ້ອຍຈະຕິດຕໍ່ທ່ານໄດ້ແນວໃດ?"

#: warehouse/templates/email/password-compromised/body.html:23
#, python-format
msgid ""
"For more information, you can email %(email_address)s to communicate with "
"the PyPI administrators."
msgstr ""
"ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ທ່ານສາມາດສົ່ງອີເມລຫາ %(email_address)s ເພື່ອຕິດຕໍ່ກັບຜູ້ດູແລລະບົບ PyPI."

#: warehouse/templates/email/password-compromised-hibp/body.html:6
msgid ""
"During your recent attempt to log in or upload to PyPI, we noticed your "
"password appears in public data breaches. To protect you and other users, we "
"have preemptively reset your password and you will no longer be able to log "
"in or upload to PyPI with your existing password."
msgstr ""
"ໃນລະຫວ່າງການພະຍາຍາມເຂົ້າສູ່ລະບົບ ຫຼື ອັບໂຫຼດໄປຫາ PyPI ຫວ່າງມໍ່ໆນີ້, "
"ພວກເຮົາສັງເກດເຫັນວ່າລະຫັດຜ່ານຂອງທ່ານປາກົດຢູ່ໃນຂໍ້ມູນທີ່ຮົ່ວໄຫຼໃນສາທາລະນະ. ເພື່ອປົກປ້ອງທ່ານ ແລະ "
"ຜູ້ໃຊ້ອື່ນໆ, ພວກເຮົາໄດ້ຕັ້ງລະຫັດຜ່ານຂອງທ່ານໃໝ່ໄວ້ກ່ອນ ແລະ ທ່ານຈະບໍ່ສາມາດເຂົ້າສູ່ລະບົບ ຫຼື ອັບໂຫຼດໄປຫາ "
"PyPI ດ້ວຍລະຫັດຜ່ານເກົ່າໄດ້ອີກ."

#: warehouse/templates/email/password-compromised-hibp/body.html:12
#, python-format
msgid ""
"PyPI itself has not suffered a breach. This is a protective measure to "
"reduce the risk of <a href=\"%(href)s\">credential stuffing</a> attacks "
"against PyPI and its users."
msgstr ""
"ຕົວລະບົບ PyPI ເອງບໍ່ໄດ້ຖືກບຸກລຸກ. ນີ້ແມ່ນມາດຕະການປ້ອງກັນເພື່ອຫຼຸດຜ່ອນຄວາມສ່ຽງຈາກການໂຈມຕີແບບ <a "
"href=\"%(href)s\">credential stuffing</a> ຕໍ່ PyPI ແລະ ຜູ້ໃຊ້."

#: warehouse/templates/email/password-compromised-hibp/body.html:18
#, python-format
msgid ""
"To regain access to your account, <a href=\"%(reset_pw_url)s\">reset your "
"password</a> on PyPI. We also recommend that you go to <a "
"href=\"%(have_i_been_pwned_url)s\">HaveIBeenPwned</a> and check your other "
"passwords and get yourself familiar with good password practices."
msgstr ""
"ເພື່ອເຂົ້າເຖິງບັນຊີຂອງທ່ານຄືນໃໝ່, ກະລຸນາ <a "
"href=\"%(reset_pw_url)s\">ຕັ້ງລະຫັດຜ່ານຂອງທ່ານໃໝ່</a> ໃນ PyPI. "
"ພວກເຮົາຍັງແນະນຳໃຫ້ທ່ານໄປທີ່ <a href=\"%(have_i_been_pwned_url)s\">HaveIBeenPwned</"
"a> ເພື່ອກວດສອບລະຫັດຜ່ານອື່ນໆຂອງທ່ານ ແລະ ສຶກສາວິທີການໃຊ້ລະຫັດຜ່ານທີ່ດີ."

#: warehouse/templates/email/password-compromised-hibp/body.html:22
msgid "How do you know this?"
msgstr "ທ່ານຮູ້ເລື່ອງນີ້ໄດ້ແນວໃດ?"

#: warehouse/templates/email/password-compromised-hibp/body.html:24
#, python-format
msgid ""
"We use a free security service from <a "
"href=\"%(have_i_been_pwned_url)s\">HaveIBeenPwned</a>. When registering, "
"authenticating, or updating your password, we generate a SHA1 hash of your "
"password and use the first 5 characters of the hash to decide if the "
"password is compromised. The plaintext password is never stored by PyPI or "
"sent to HaveIBeenPwned."
msgstr ""
"ພວກເຮົາໃຊ້ບໍລິການຄວາມປອດໄພຟຣີຈາກ <a "
"href=\"%(have_i_been_pwned_url)s\">HaveIBeenPwned</a>. ເມື່ອມີການລົງທະບຽນ, "
"ຢືນຢັນຕົວຕົນ ຫຼື ອັບເດດລະຫັດຜ່ານ, ພວກເຮົາຈະສ້າງ SHA1 hash ຂອງລະຫັດຜ່ານຂອງທ່ານ ແລະ ໃຊ້ 5 "
"ຕົວອັກສອນທຳອິດຂອງ hash ເພື່ອຕັດສິນວ່າລະຫັດຜ່ານນັ້ນປອດໄພຫຼືບໍ່. "
"ລະຫັດຜ່ານແບບຂໍ້ຄວາມທຳມະດາຈະບໍ່ຖືກເກັບໄວ້ໃນ PyPI ຫຼື ສົ່ງໄປຫາ HaveIBeenPwned ເດັດຂາດ."

#: warehouse/templates/email/password-compromised-hibp/body.html:29
#, python-format
msgid ""
"For more information, see our <a href=\"%(faq_url)s\">FAQ</a>. For help, you "
"can email <a href=\"%(email_href)s\">%(email_address)s</a> to communicate "
"with the PyPI administrators."
msgstr ""
"ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ, ເບິ່ງທີ່ <a href=\"%(faq_url)s\">ຄຳຖາມທີ່ພົບເລື້ອຍ (FAQ)</a>. "
"ຫາກຕ້ອງການຄວາມຊ່ວຍເຫຼືອ, ທ່ານສາມາດສົ່ງອີເມລຫາ <a "
"href=\"%(email_href)s\">%(email_address)s</a> ເພື່ອຕິດຕໍ່ກັບຜູ້ດູແລລະບົບ PyPI."

#: warehouse/templates/email/password-reset/body.html:5
#, python-format
msgid ""
"Someone, perhaps you, has made a password reset request for your PyPI "
"account '%(username)s'."
msgstr ""
"ມີບາງຄົນ, ຫຼື ອາດແມ່ນທ່ານ, ໄດ້ຮ້ອງຂໍຕັ້ງລະຫັດຜ່ານໃໝ່ສຳລັບບັນຊີ PyPI '%(username)s' ຂອງທ່ານ."

#: warehouse/templates/email/password-reset/body.html:8
#, python-format
msgid ""
"If you wish to proceed with this request, <a href=\"%(href)s\">click to "
"reset your password</a>."
msgstr ""
"ຖ້າທ່ານຕ້ອງການດຳເນີນການຕາມການຮ້ອງຂໍນີ້, <a href=\"%(href)s\">ຄລິກເພື່ອຕັ້ງລະຫັດຜ່ານໃໝ່</a>."

#: warehouse/templates/email/password-reset/body.html:11
#: warehouse/templates/email/verify-email/body.html:11
#, python-format
msgid "This link will expire in %(n_hours)s hour."
msgid_plural "This link will expire in %(n_hours)s hours."
msgstr[0] "ລິ້ງນີ້ຈະໝົດອາຍຸພາຍໃນ %(n_hours)s ຊົ່ວໂມງ."

#: warehouse/templates/email/password-reset-unverified/body.html:19
#: warehouse/templates/email/password-reset/body.html:15
#: warehouse/templates/email/verify-email/body.html:15
msgid "If you did not make this request, you can safely ignore this email."
msgstr "ຖ້າທ່ານບໍ່ໄດ້ສົ່ງຄຳຮ້ອງຂໍນີ້, ທ່ານສາມາດລະເລີຍອີເມລນີ້ໄດ້."

#: warehouse/templates/email/password-reset-unverified/body.html:5
msgid ""
"Someone, perhaps you, has made a password reset request for a PyPI account "
"associated with this email address."
msgstr "ມີບາງຄົນ, ຫຼື ອາດແມ່ນທ່ານ, ໄດ້ຮ້ອງຂໍຕັ້ງລະຫັດຜ່ານໃໝ່ສຳລັບບັນຊີ PyPI ທີ່ກ່ຽວຂ້ອງກັບທີ່ຢູ່ອີເມລນີ້."

#: warehouse/templates/email/password-reset-unverified/body.html:8
msgid ""
"However, the email used to make this request is not verified. Your email "
"address must be verified before you can use it to reset your password."
msgstr ""
"ແນວໃດກໍຕາມ, ອີເມລທີ່ໃຊ້ໃນການຮ້ອງຂໍນີ້ຍັງບໍ່ທັນໄດ້ຮັບການຢືນຢັນ. ທີ່ຢູ່ອີເມລຂອງທ່ານຕ້ອງໄດ້ຮັບການຢືນຢັນກ່ອນ "
"ທ່ານຈຶ່ງຈະສາມາດໃຊ້ມັນເພື່ອຕັ້ງລະຫັດຜ່ານໃໝ່ໄດ້."

#: warehouse/templates/email/password-reset-unverified/body.html:11
msgid ""
"If you have another verified email address associated with your PyPI "
"account, try that instead."
msgstr "ຖ້າທ່ານມີທີ່ຢູ່ອີເມລອື່ນທີ່ຢືນຢັນແລ້ວທີ່ກ່ຽວຂ້ອງກັບບັນຊີ PyPI ຂອງທ່ານ, ກະລຸນາລອງໃຊ້ອີເມລນັ້ນແທນ."

#: warehouse/templates/email/password-reset-unverified/body.html:14
#, python-format
msgid ""
"If you cannot use another verified email, follow <a "
"href=\"%(href)s\">account recovery steps</a> for your PyPI account."
msgstr ""
"ຖ້າທ່ານບໍ່ສາມາດໃຊ້ທີ່ຢູ່ອີເມລອື່ນທີ່ຢືນຢັນແລ້ວໄດ້, ກະລຸນາປະຕິບັດຕາມ <a "
"href=\"%(href)s\">ຂັ້ນຕອນການກູ້ຄືນບັນຊີ</a> ສຳລັບບັນຊີ PyPI ຂອງທ່ານ."

#: warehouse/templates/email/password-reset-unverified/body.html:17
#, python-format
msgid "<a href=\"%(href)s\">Read more about verified emails.</a>"
msgstr "<a href=\"%(href)s\">ອ່ານເພີ່ມເຕີມກ່ຽວກັບອີເມລທີ່ຢືນຢັນແລ້ວ.</a>"

#: warehouse/templates/email/primary-email-change/body.html:5
#, python-format
msgid ""
"The primary email for your PyPI account <strong>%(username)s</strong> has "
"been changed from <code>%(old_email)s</code> to <code>%(new_email)s</code>"
msgstr ""
"ອີເມລຫຼັກສຳລັບບັນຊີ PyPI ຂອງທ່ານ <strong>%(username)s</strong> ໄດ້ຖືກປ່ຽນຈາກ "
"<code>%(old_email)s</code> ເປັນ <code>%(new_email)s</code> ແລ້ວ"

#: warehouse/templates/email/recovery-code-reminder/body.html:5
#, python-format
msgid ""
"We noticed you recently logged into your PyPI account <strong>%(username)s</"
"strong>, which has two-factor authentication enabled, but haven't generated "
"recovery codes for this account."
msgstr ""
"ພວກເຮົາສັງເກດເຫັນວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບບັນຊີ PyPI ຂອງທ່ານ <strong>%(username)s</strong> "
"ຫວ່າງມໍ່ໆນີ້, ເຊິ່ງບັນຊີນີ້ໄດ້ເປີດໃຊ້ການຢືນຢັນຕົວຕົນສອງຂັ້ນຕອນໄວ້ ແຕ່ທ່ານຍັງບໍ່ທັນໄດ້ສ້າງລະຫັດກູ້ຄືນສຳລັບບັນຊີນີ້."

#: warehouse/templates/email/recovery-code-reminder/body.html:12
msgid ""
"If you lose your authentication application or security key(s) and do not "
"have access to these recovery codes, you may permanently lose access to your "
"PyPI account!"
msgstr ""
"ຖ້າທ່ານເສຍແອັບພລິເຄຊັນຢືນຢັນຕົວຕົນ ຫຼື ຄີຄວາມປອດໄພ ແລະ ບໍ່ມີລະຫັດກູ້ຄືນເຫຼົ່ານີ້, "
"ທ່ານອາດຈະເສຍການເຂົ້າເຖິງບັນຊີ PyPI ຂອງທ່ານຖາວອນ!"

#: warehouse/templates/email/recovery-code-reminder/body.html:19
#, python-format
msgid ""
"You can generate recovery codes for your account here: <a "
"href=\"%(href)s\">%(href)s</a>"
msgstr "ທ່ານສາມາດສ້າງລະຫັດກູ້ຄືນສຳລັບບັນຊີຂອງທ່ານໄດ້ທີ່ນີ້: <a href=\"%(href)s\">%(href)s</a>"

#: warehouse/templates/email/recovery-code-used/body.html:5
#, python-format
msgid ""
"A recovery code for your PyPI account <strong>%(username)s</strong> has been "
"used."
msgstr "ລະຫັດກູ້ຄືນສຳລັບບັນຊີ PyPI ຂອງທ່ານ <strong>%(username)s</strong> ຖືກນຳໃຊ້ແລ້ວ."

#: warehouse/templates/email/recovery-codes-generated/body.html:5
#, python-format
msgid ""
"New recovery codes for your PyPI account <strong>%(username)s</strong> have "
"been generated."
msgstr "ລະຫັດກູ້ຄືນໃໝ່ສຳລັບບັນຊີ PyPI ຂອງທ່ານ <strong>%(username)s</strong> ຖືກສ້າງຂຶ້ນແລ້ວ."

#: warehouse/templates/email/removed-as-organization-member/body.html:5
#, python-format
msgid "You have been removed from the \"%(organization_name)s\" organization"
msgstr "ທ່ານຖືກຍ້າຍອອກຈາກອົງກອນ \"%(organization_name)s\" ແລ້ວ"

#: warehouse/templates/email/removed-as-organization-member/body.html:9
msgid "You are receiving this because you were a member of this organization."
msgstr "ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າທ່ານເຄີຍເປັນສະມາຊິກຂອງອົງກອນນີ້."

#: warehouse/templates/email/removed-as-team-collaborator/body.html:5
#, python-format
msgid ""
"Your team was removed from the %(site)s project %(project)s by %(submitter)s."
msgstr "ທິມຂອງທ່ານຖືກຍ້າຍອອກຈາກໂປຣເຈັກ %(site)s %(project)s ໂດຍ %(submitter)s."

#: warehouse/templates/email/removed-as-team-collaborator/body.html:8
#, python-format
msgid ""
"You are receiving this because your team was removed by %(submitter)s from a "
"project on %(site)s."
msgstr ""
"ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າທິມຂອງທ່ານຖືກຍ້າຍອອກໂດຍ %(submitter)s ຈາກໂປຣເຈັກໃດໜຶ່ງໃນ %(site)s."

#: warehouse/templates/email/removed-as-team-member/body.html:5
#, python-format
msgid ""
"You have been removed from the \"%(team_name)s\" team in the "
"\"%(organization_name)s\" organization"
msgstr ""
"ທ່ານຖືກຍ້າຍອອກຈາກທິມ \"%(team_name)s\" ໃນອົງກອນ \"%(organization_name)s\" ແລ້ວ"

#: warehouse/templates/email/removed-as-team-member/body.html:9
msgid "You are receiving this because you were a member of this team."
msgstr "ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າທ່ານເຄີຍເປັນສະມາຊິກຂອງທິມນີ້."

#: warehouse/templates/email/role-changed-as-organization-member/body.html:6
#, python-format
msgid ""
"Your role in the \"%(organization_name)s\" organization has been changed to "
"<strong>%(role)s</strong> by %(submitter)s"
msgstr ""
"ບົດບາດຂອງທ່ານໃນອົງກອນ \"%(organization_name)s\" ຖືກປ່ຽນເປັນ <strong>%(role)s</"
"strong> ໂດຍ %(submitter)s ແລ້ວ"

#: warehouse/templates/email/role-changed-as-team-collaborator/body.html:6
#, python-format
msgid ""
"Your team's role for the %(project)s project has been changed by "
"%(submitter)s."
msgstr "ບົດບາດຂອງທິມທ່ານສຳລັບໂປຣເຈັກ %(project)s ຖືກປ່ຽນໂດຍ %(submitter)s ແລ້ວ."

#: warehouse/templates/email/role-changed-as-team-collaborator/body.html:10
msgid ""
"Your team now has permissions to administer the project. You can add other "
"collaborators, upload releases and delete files, releases or the entire "
"project."
msgstr ""
"ດຽວນີ້ທິມຂອງທ່ານມີສິດໃນການບໍລິຫານໂປຣເຈັກ. ທ່ານສາມາດເພີ່ມຜູ້ຮ່ວມງານຄົນອື່ນໆ, ອັບໂຫຼດລຸ້ນໃໝ່ "
"(releases) ແລະ ລຶບໄຟລ໌, ລຸ້ນຕ່າງໆ ຫຼື ໂປຣເຈັກທັງໝົດໄດ້."

#: warehouse/templates/email/role-changed-as-team-collaborator/body.html:12
msgid ""
"Your team now has permissions to upload releases for the project. You can "
"upload releases but cannot add collaborators, delete files, releases or the "
"project."
msgstr ""
"ດຽວນີ້ທິມຂອງທ່ານມີສິດໃນການອັບໂຫຼດລຸ້ນໃໝ່ (releases) ສຳລັບໂປຣເຈັກ. ທ່ານສາມາດອັບໂຫຼດລຸ້ນໃໝ່ໄດ້ "
"ແຕ່ບໍ່ສາມາດເພີ່ມຜູ້ຮ່ວມງານ, ລຶບໄຟລ໌, ລຸ້ນຕ່າງໆ ຫຼື ໂປຣເຈັກໄດ້."

#: warehouse/templates/email/role-changed-as-team-collaborator/body.html:17
#, python-format
msgid ""
"You are receiving this because your team's role was changed by %(submitter)s "
"for the %(project)s project."
msgstr ""
"ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າບົດບາດຂອງທິມທ່ານຖືກປ່ຽນໂດຍ %(submitter)s ສຳລັບໂປຣເຈັກ %(project)s."

#: warehouse/templates/email/team-collaborator-added/body.html:11
#, python-format
msgid "A new collaborator has been added to a project you own on %(site)s"
msgstr "ມີຜູ້ຮ່ວມງານໃໝ່ຖືກເພີ່ມເຂົ້າໃນໂປຣເຈັກທີ່ທ່ານເປັນເຈົ້າຂອງໃນ %(site)s"

#: warehouse/templates/email/team-collaborator-added/body.html:14
#: warehouse/templates/email/team-collaborator-removed/body.html:14
#: warehouse/templates/email/team-collaborator-role-changed/body.html:14
msgid "Team"
msgstr "ທິມ"

#: warehouse/templates/email/team-collaborator-added/body.html:17
#: warehouse/templates/email/team-collaborator-role-changed/body.html:17
#: warehouse/templates/manage/account/token.html:145
msgid "Permissions"
msgstr "ສິດການນຳໃຊ້"

#: warehouse/templates/email/team-collaborator-added/body.html:20
#: warehouse/templates/email/team-collaborator-removed/body.html:17
#: warehouse/templates/email/team-collaborator-role-changed/body.html:20
msgid "Collaborator for"
msgstr "ຜູ້ຮ່ວມງານສຳລັບ"

#: warehouse/templates/email/team-collaborator-added/body.html:32
#: warehouse/templates/email/team-collaborator-removed/body.html:29
#: warehouse/templates/email/team-collaborator-role-changed/body.html:32
msgid "You are receiving this because you are an owner of this project."
msgstr "ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າທ່ານເປັນເຈົ້າຂອງໂປຣເຈັກນີ້."

#: warehouse/templates/email/team-collaborator-removed/body.html:11
#, python-format
msgid "A collaborator was removed from a project you own on %(site)s"
msgstr "ຜູ້ຮ່ວມງານຖືກຍ້າຍອອກຈາກໂປຣເຈັກທີ່ທ່ານເປັນເຈົ້າຂອງໃນ %(site)s"

#: warehouse/templates/email/team-collaborator-role-changed/body.html:11
#, python-format
msgid ""
"A collaborator's permissions were changed for a project you own on %(site)s"
msgstr "ສິດການນຳໃຊ້ຂອງຜູ້ຮ່ວມງານຖືກປ່ຽນແປງສຳລັບໂປຣເຈັກທີ່ທ່ານເປັນເຈົ້າຂອງໃນ %(site)s"

#: warehouse/templates/email/team-created/body.html:5
#, python-format
msgid ""
"A team named \"%(team_name)s\" has been created in the "
"\"%(organization_name)s\" organization."
msgstr "ທິມທີ່ຊື່ວ່າ \"%(team_name)s\" ໄດ້ຖືກສ້າງຂຶ້ນໃນອົງກອນ \"%(organization_name)s\"."

#: warehouse/templates/email/team-created/body.html:9
#: warehouse/templates/email/team-deleted/body.html:9
#: warehouse/templates/email/team-member-added/body.html:9
#: warehouse/templates/email/team-member-removed/body.html:9
msgid ""
"You are receiving this because you are an owner or a manager of the "
"organization."
msgstr "ທ່ານໄດ້ຮັບອີເມລນີ້ເພາະວ່າທ່ານເປັນເຈົ້າຂອງ ຫຼື ເປັນຜູ້ຈັດການຂອງອົງກອນ."

#: warehouse/templates/email/team-deleted/body.html:5
#, python-format
msgid ""
"A team named \"%(team_name)s\" has been deleted in the "
"\"%(organization_name)s\" organization."
msgstr "ທິມທີ່ຊື່ວ່າ \"%(team_name)s\" ໃນອົງກອນ \"%(organization_name)s\" ຖືກລຶບແລ້ວ."

#: warehouse/templates/email/team-member-added/body.html:5
#, python-format
msgid ""
"<a href=\"%(user_profile)s\">%(username)s</a> has been added as a member of "
"the \"%(team_name)s\" team in the \"%(organization_name)s\" organization by "
"<a href=\"%(submitter_profile)s\">%(submitter)s</a>."
msgstr ""
"<a href=\"%(user_profile)s\">%(username)s</a> ຖືກເພີ່ມເປັນສະມາຊິກຂອງທິມ "
"\"%(team_name)s\" ໃນອົງກອນ \"%(organization_name)s\" ໂດຍ <a "
"href=\"%(submitter_profile)s\">%(submitter)s</a>."

#: warehouse/templates/email/team-member-removed/body.html:5
#, python-format
msgid ""
"<a href=\"%(user_profile)s\">%(username)s</a> has been removed as a member "
"of the \"%(team_name)s\" team in the \"%(organization_name)s\" organization "
"by <a href=\"%(submitter_profile)s\">%(submitter)s</a>."
msgstr ""
"<a href=\"%(user_profile)s\">%(username)s</a> ຖືກຍ້າຍອອກຈາກສະມາຊິກຂອງທິມ "
"\"%(team_name)s\" ໃນອົງກອນ \"%(organization_name)s\" ໂດຍ <a "
"href=\"%(submitter_profile)s\">%(submitter)s</a>."

#: warehouse/templates/email/two-factor-added/body.html:5
#, python-format
msgid ""
"Someone, perhaps you, has added a %(method)s two-factor authentication "
"method to your PyPI account <strong>%(username)s</strong>."
msgstr ""
"ມີບາງຄົນ, ຫຼື ອາດແມ່ນທ່ານ, ໄດ້ເພີ່ມວິທີການຢືນຢັນຕົວຕົນສອງຂັ້ນຕອນແບບ %(method)s ເຂົ້າໃນບັນຊີ PyPI "
"ຂອງທ່ານ <strong>%(username)s</strong>."

#: warehouse/templates/email/two-factor-removed/body.html:5
#, python-format
msgid ""
"Someone, perhaps you, has removed a %(method)s two-factor authentication "
