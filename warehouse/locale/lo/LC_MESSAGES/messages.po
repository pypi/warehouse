#: warehouse/views.py:150
msgid ""
"You must verify your **primary** email address before you can perform this "
"action."
msgstr "ທ່ານຕ້ອງຢືນຢັນທີ່ຢູ່ອີເມວ **ຫຼັກ** ຂອງທ່ານກ່ອນ ຈຶ່ງຈະສາມາດດຳເນີນການນີ້ໄດ້."

#: warehouse/views.py:166
msgid ""
"Two-factor authentication must be enabled on your account to perform this "
"action."
msgstr "ຕ້ອງເປີດໃຊ້ງານການຢືນຢັນຕົວຕົນແບບສອງຂັ້ນຕອນໃນບັນຊີຂອງທ່ານ ເພື່ອດຳເນີນການນີ້."

#: warehouse/views.py:377
msgid "Locale updated"
msgstr "ອັບເດດພາສາທ້ອງຖິ່ນແລ້ວ"

#: warehouse/accounts/forms.py:48 warehouse/accounts/forms.py:344
msgid "The email address isn't valid. Try again."
msgstr "ທີ່ຢູ່ອີເມວບໍ່ຖືກຕ້ອງ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: warehouse/accounts/forms.py:49
msgid "The password is invalid. Try again."
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: warehouse/accounts/forms.py:51
msgid ""
"The username is invalid. Usernames must be composed of letters, numbers, "
"dots, hyphens and underscores. And must also start and finish with a letter "
"or number. Choose a different username."
msgstr ""
"ຊື່ຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ. ຊື່ຜູ້ໃຊ້ຕ້ອງປະກອບດ້ວຍ ຕົວອັກສອນ, ຕົວເລກ, ຈໍ້າ (.), ຂີດຕໍ່ (-) ແລະ ຂີດກ້ອງ (_). "
"ທັງຕ້ອງເລີ່ມຕົ້ນ ແລະ ລົງທ້າຍດ້ວຍຕົວອັກສອນ ຫຼື ຕົວເລກເທົ່ານັ້ນ. ກະລຸນາເລືອກຊື່ຜູ້ໃຊ້ອື່ນ."

#: warehouse/accounts/forms.py:68
msgid "Null bytes are not allowed."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ມີໄບທ໌ຫວ່າງ (Null bytes)."

#: warehouse/accounts/forms.py:84
msgid ""
"Usernames are not the same as email addresses. Enter your username instead "
"of your email address."
msgstr "ຊື່ຜູ້ໃຊ້ບໍ່ແມ່ນອັນດຽວກັບທີ່ຢູ່ອີເມວ. ກະລຸນາປ້ອນຊື່ຜູ້ໃຊ້ຂອງທ່ານແທນທີ່ຢູ່ອີເມວ."

#: warehouse/accounts/forms.py:96
msgid "No user found with that username"
msgstr "ບໍ່ພົບຜູ້ໃຊ້ທີ່ໃຊ້ຊື່ຜູ້ໃຊ້ນີ້"

#: warehouse/accounts/forms.py:124
#, python-brace-format
msgid "TOTP code must be ${totp_length} digits."
msgstr "ລະຫັດ TOTP ຕ້ອງມີ ${totp_length} ຫຼັກ."

#: warehouse/accounts/forms.py:147
#, python-brace-format
msgid "Recovery Codes must be ${recovery_code_length} characters."
msgstr "ລະຫັດກູ້ຄືນຕ້ອງມີ ${recovery_code_length} ຕົວອັກສອນ."

#: warehouse/accounts/forms.py:161
msgid "Choose a username with 50 characters or less."
msgstr "ກະລຸນາເລືອກຊື່ຜູ້ໃຊ້ທີ່ມີຄວາມຍາວບໍ່ເກີນ 50 ຕົວອັກສອນ."

#: warehouse/accounts/forms.py:179
msgid ""
"This username is already being used by another account. Choose a different "
"username."
msgstr "ຊື່ຜູ້ໃຊ້ນີ້ຖືກໃຊ້ໂດຍບັນຊີອື່ນແລ້ວ. ກະລຸນາເລືອກຊື່ຜູ້ໃຊ້ອື່ນ."

#: warehouse/accounts/forms.py:218 warehouse/accounts/forms.py:275
#: warehouse/accounts/forms.py:288
msgid "Password too long."
msgstr "ລະຫັດຜ່ານຍາວເກີນໄປ."

#: warehouse/accounts/forms.py:258
#, python-brace-format
msgid ""
"There have been too many unsuccessful login attempts. You have been locked "
"out for ${time}. Please try again later."
msgstr ""
"ມີການພະຍາຍາມເຂົ້າສູ່ລະບົບບໍ່ສຳເລັດຫຼາຍເກີນໄປ. ທ່ານຖືກລະງັບການເຂົ້າໃຊ້ງານເປັນເວລາ ${time}. "
"ກະລຸນາລອງໃໝ່ອີກຄັ້ງໃນພາຍຫຼັງ."

#: warehouse/accounts/forms.py:291
msgid "Your passwords don't match. Try again."
msgstr "ລະຫັດຜ່ານຂອງທ່ານບໍ່ກົງກັນ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: warehouse/accounts/forms.py:325
msgid "The email address is too long. Try again."
msgstr "ທີ່ຢູ່ອີເມວຍາວເກີນໄປ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: warehouse/accounts/forms.py:397
msgid "You can't use an email address from this domain. Use a different email."
msgstr "ທ່ານບໍ່ສາມາດໃຊ້ທີ່ຢູ່ອີເມວຈາກໂດເມນນີ້ໄດ້. ກະລຸນາໃຊ້ອີເມວອື່ນ."

#: warehouse/accounts/forms.py:412
msgid ""
"This email address is already being used by this account. Use a different "
"email."
msgstr "ທີ່ຢູ່ອີເມວນີ້ນຳໃຊ້ໂດຍບັນຊີນີ້ແລ້ວ. ກະລຸນາໃຊ້ອີເມວອື່ນ."

#: warehouse/accounts/forms.py:423
msgid ""
"This email address is already being used by another account. Use a different "
"email."
msgstr "ທີ່ຢູ່ອີເມວນີ້ນຳໃຊ້ໂດຍບັນຊີອື່ນແລ້ວ. ກະລຸນາໃຊ້ອີເມວອື່ນ."

#: warehouse/accounts/forms.py:463 warehouse/manage/forms.py:129
msgid "The name is too long. Choose a name with 100 characters or less."
msgstr "ຊື່ຍາວເກີນໄປ. ກະລຸນາເລືອກຊື່ທີ່ມີຄວາມຍາວບໍ່ເກີນ 100 ຕົວອັກສອນ."

#: warehouse/accounts/forms.py:468
msgid "URLs are not allowed in the name field."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ໃສ່ URL ໃນຫ້ອງປ້ອນຊື່."

#: warehouse/accounts/forms.py:557
msgid "Invalid TOTP code."
msgstr "ລະຫັດ TOTP ບໍ່ຖືກຕ້ອງ."

#: warehouse/accounts/forms.py:574
msgid "Invalid WebAuthn assertion: Bad payload"
msgstr "ການຢືນຢັນ WebAuthn ບໍ່ຖືກຕ້ອງ: Payload ຜິດພາດ"

#: warehouse/accounts/forms.py:638
msgid "Invalid recovery code."
msgstr "ລະຫັດກູ້ຄືນບໍ່ຖືກຕ້ອງ."

#: warehouse/accounts/forms.py:647
msgid "Recovery code has been previously used."
msgstr "ລະຫັດກູ້ຄືນນີ້ເຄີຍຖືກໃຊ້ໄປແລ້ວ."

#: warehouse/accounts/forms.py:676
msgid "The username isn't valid. Try again."
msgstr "ຊື່ຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: warehouse/accounts/views.py:121
msgid ""
"There have been too many unsuccessful login attempts. You have been locked "
"out for Please try again later."
msgstr ""
"ມີການພະຍາຍາມເຂົ້າສູ່ລະບົບບໍ່ສຳເລັດຫຼາຍເກີນໄປ. ທ່ານຖືກລະງັບການເຂົ້າໃຊ້ງານ, "
"ກະລຸນາລອງໃໝ່ອີກຄັ້ງໃນພາຍຫຼັງ."

#: warehouse/accounts/views.py:141
#, python-brace-format
msgid ""
"Too many emails have been added to this account without verifying them. "
"Check your inbox and follow the verification links. (IP: ${ip})"
msgstr ""
"ມີການເພີ່ມອີເມວຫຼາຍເກີນໄປໃນບັນຊີນີ້ໂດຍທີ່ຍັງບໍ່ທັນໄດ້ຢືນຢັນ. ກະລຸນາກວດເບິ່ງກ່ອງຈົດໝາຍຂອງທ່ານ ແລະ "
"ກົດລິ້ງຢືນຢັນ. (IP: ${ip})"

#: warehouse/accounts/views.py:153
#, python-brace-format
msgid ""
"Too many password resets have been requested for this account without "
"completing them. Check your inbox and follow the verification links. (IP: $"
"{ip})"
msgstr ""
"ມີການຮ້ອງຂໍຕັ້ງລະຫັດຜ່ານໃໝ່ຫຼາຍເກີນໄປສຳລັບບັນຊີນີ້ໂດຍທີ່ຍັງບໍ່ທັນສຳເລັດ. ກະລຸນາກວດເບິ່ງກ່ອງຈົດໝາຍຂອງທ່ານ "
"ແລະ ກົດລິ້ງຢືນຢັນ. (IP: ${ip})"

#: warehouse/accounts/views.py:376 warehouse/accounts/views.py:444
#: warehouse/accounts/views.py:446 warehouse/accounts/views.py:475
#: warehouse/accounts/views.py:477 warehouse/accounts/views.py:593
msgid "Invalid or expired two factor login."
msgstr "ການເຂົ້າສູ່ລະບົບແບບສອງຂັ້ນຕອນບໍ່ຖືກຕ້ອງ ຫຼື ໝົດອາຍຸແລ້ວ."

#: warehouse/accounts/views.py:438
msgid "Already authenticated"
msgstr "ຢືນຢັນຕົວຕົນແລ້ວ"

#: warehouse/accounts/views.py:512
msgid "Successful WebAuthn assertion"
msgstr "ການຢືນຢັນ WebAuthn ສຳເລັດແລ້ວ"

#: warehouse/accounts/views.py:623 warehouse/manage/views/__init__.py:957
msgid "Recovery code accepted. The supplied code cannot be used again."
msgstr "ຍອມຮັບລະຫັດກູ້ຄືນແລ້ວ. ລະຫັດທີ່ໃຫ້ມານີ້ຈະບໍ່ສາມາດນຳມາໃຊ້ໄດ້ອີກ."

#: warehouse/accounts/views.py:730
msgid ""
"New user registration temporarily disabled. See https://pypi.org/help#admin-"
"intervention for details."
msgstr ""
"ປິດການລົງທະບຽນຜູ້ໃຊ້ໃໝ່ຊົ່ວຄາວ. ເບິ່ງລາຍລະອຽດໄດ້ທີ່ https://pypi.org/help#admin-"
"intervention"

#: warehouse/accounts/views.py:893
msgid "Expired token: request a new password reset link"
msgstr "ໂທເຄັນໝົດອາຍຸ: ກະລຸນາຮ້ອງຂໍລິ້ງຕັ້ງລະຫັດຜ່ານໃໝ່"

#: warehouse/accounts/views.py:895
msgid "Invalid token: request a new password reset link"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ກະລຸນາຮ້ອງຂໍລິ້ງຕັ້ງລະຫັດຜ່ານໃໝ່"

#: warehouse/accounts/views.py:897 warehouse/accounts/views.py:1010
#: warehouse/accounts/views.py:1075 warehouse/accounts/views.py:1181
#: warehouse/accounts/views.py:1352
msgid "Invalid token: no token supplied"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ບໍ່ມີການສົ່ງໂທເຄັນມາ"

#: warehouse/accounts/views.py:901
msgid "Invalid token: not a password reset token"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ບໍ່ແມ່ນໂທເຄັນສຳລັບຕັ້ງລະຫັດຜ່ານໃໝ່"

#: warehouse/accounts/views.py:906 warehouse/accounts/views.py:1019
msgid "Invalid token: user not found"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ບໍ່ພົບຜູ້ໃຊ້"

#: warehouse/accounts/views.py:917
msgid "Invalid token: user has logged in since this token was requested"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ຜູ້ໃຊ້ໄດ້ເຂົ້າສູ່ລະບົບແລ້ວນັບຕັ້ງແຕ່ໂທເຄັນນີ້ຖືກຮ້ອງຂໍ"

#: warehouse/accounts/views.py:935
msgid ""
"Invalid token: password has already been changed since this token was "
"requested"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ລະຫັດຜ່ານຖືກປ່ຽນແລ້ວນັບຕັ້ງແຕ່ໂທເຄັນນີ້ຖືກຮ້ອງຂໍ"

#: warehouse/accounts/views.py:966
msgid "You have reset your password"
msgstr "ທ່ານໄດ້ຕັ້ງລະຫັດຜ່ານໃໝ່ແລ້ວ"

#: warehouse/accounts/views.py:1006
msgid "Expired token: please try to login again"
msgstr "ໂທເຄັນໝົດອາຍຸ: ກະລຸນາລອງເຂົ້າສູ່ລະບົບໃໝ່ອີກຄັ້ງ"

#: warehouse/accounts/views.py:1008
msgid "Invalid token: please try to login again"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ກະລຸນາລອງເຂົ້າສູ່ລະບົບໃໝ່ອີກຄັ້ງ"

#: warehouse/accounts/views.py:1014
msgid "Invalid token: not a login confirmation token"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ: ບໍ່ແມ່ນໂທເຄັນສຳລັບຢືນຢັນການເຂົ້າສູ່ລະບົບ"

#: warehouse/accounts/views.py:1029
msgid "Invalid login attempt."
msgstr "ການພະຍາຍາມເຂົ້າສູ່ລະບົບບໍ່ຖືກຕ້ອງ."

#: warehouse/accounts/views.py:1034
msgid ""
"Device details didn't match, please try again from the device you originally "
"used to log in."
msgstr "ລາຍລະອຽດອຸປະກອນບໍ່ກົງກັນ, ກະລຸນາລອງໃໝ່ອີກຄັ້ງຈາກອຸປະກອນທີ່ທ່ານເຄີຍໃຊ້ເຂົ້າສູ່ລະບົບກ່ອນໜ້ານີ້."

#: warehouse/accounts/views.py:1045
msgid "Your login has been confirmed and this device is now recognized."
msgstr "ຢືນຢັນການເຂົ້າສູ່ລະບົບຂອງທ່ານແລ້ວ ແລະ ລະບົບຈື່ຈຳອຸປະກອນນີ້ແລ້ວ."

#: warehouse/accounts/views.py:1071
msgid "Expired token: request a new email verification link"
msgstr "ໂທເຄັນໝົດອາຍຸ: ກະລຸນາຮ້ອງຂໍລິ້ງຢືນຢັນອີເມວໃໝ່"

#: warehouse/accounts/views.py:1073
msgid "Invalid token: request a new email verification link"
